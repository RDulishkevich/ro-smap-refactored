{
  "name": "Полёвка — карта звуков",
  "short_name": "Полёвка",
  "description": "Карта звуков: слушать, находить и добавлять полевые записи.",
  "lang": "ru",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#E8EDEA",
  "theme_color": "#B5613F",
  "handle_links": "preferred",
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "related_applications": [
    { "platform": "webapp", "url": "https://polevka.art/manifest.webmanifest" },
    { "platform": "webapp", "url": "https://www.polevka.art/manifest.webmanifest" }
  ],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
