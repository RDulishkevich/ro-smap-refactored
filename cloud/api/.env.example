# Пример env для Yandex Cloud Function (не коммитить реальные значения)

BUCKET=rosmap2026
PRIVATE_BUCKET=rosmap2026-private
STORAGE_ENDPOINT=https://storage.yandexcloud.net
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
JWT_SECRET=change-me-to-long-random-string
ADMIN_PASSWORD=change-me
ALLOWED_ORIGIN=https://polevka.art,https://www.polevka.art,http://localhost,http://127.0.0.1

# YDB Document API — source of truth (optional until created). Without it API keeps S3 JSON + CAS.
# pwsh cloud/ops/ydb-create.ps1
YDB_DOCAPI_ENDPOINT=
YDB_DOCAPI_REGION=ru-central1

# One-time migrate: allow reading catalog/auth/mail without HMAC .sig.
# Run `node cloud/ops/seal-integrity.cjs` then unset this.
INTEGRITY_ALLOW_UNSIGNED=0

# Yandex Translate (для UCS FXName: RU → EN)
YC_TRANSLATE_API_KEY=
YC_FOLDER_ID=

# Browser Maps JS key (HTTP Referer restricted). Served via action=publicConfig only.
YANDEX_MAPS_API_KEY=

# Transactional email (verification codes). Leave empty until mailbox is ready.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Unisender Go: set to 1 only after their support allows skip_unsubscribe for transactional mail
UNISENDER_SKIP_UNSUBSCRIBE=0
# Staging only — return demoCode when SMTP is missing. Never enable on production.
ALLOW_DEMO_EMAIL_CODES=0

# Web Push (generate once: node -e "console.log(require('web-push').generateVAPIDKeys())")
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@polevka.art
